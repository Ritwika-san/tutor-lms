# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tutor_lms
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/tutor_lms

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Environment
ENVIRONMENT=development

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache the Chroma ONNX embedding model under backend/.cache/.
CHROMA_ONNX_CACHE_DIR=.cache/chroma/onnx_models/all-MiniLM-L6-v2

# Minimum cosine similarity required to reuse a cached doubt answer.
DOUBT_SIMILARITY_THRESHOLD=0.95
